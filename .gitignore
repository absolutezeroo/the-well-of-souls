# Godot cache and imports (regenerated automatically)
.godot/
*.tmp

# Exports
/build/
/android/
*.apk
*.aab

# Signing keys: never in git
*.keystore
*.jks

# Local agent worktrees and tools
/.claude/worktrees/
/_tool/

# Compiled translations (made from locale/strings.csv on import)
/locale/*.translation
__pycache__/

# Talo data exports (players' ids) and the statistics pages made from them (docs/online.md)
export-*.zip
/stats_dashboard.html
/stats_dashboard.json

# The online leaderboards access key (docs/online.md): never in git
/online/talo.cfg
.captures/
