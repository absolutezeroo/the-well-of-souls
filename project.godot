; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="The Well of Souls"
config/name_localized={
"en": "The Well of Souls",
"fr": "Le Puits des Âmes"
}
config/quit_on_go_back=false
config/use_custom_user_dir=true
config/custom_user_dir_name="Mini Roguelike"
config/description="Real-time action roguelike built with GDScript."
config/version="0.3.1"
run/main_scene="res://src/ui/title/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0705882, 0.0470588, 0.117647, 1)
boot_splash/image="res://assets/icon/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=false
config/icon="res://assets/icon/icon_192.png"

[autoload]

Events="*res://src/autoload/events.gd"
Sfx="*res://src/autoload/sfx.gd"
HitStop="*res://src/autoload/hit_stop.gd"
Profile="*res://src/autoload/profile.gd"
Settings="*res://src/autoload/settings.gd"
InputDevice="*res://src/autoload/input_device.gd"
TouchScrolling="*res://src/autoload/touch_scrolling.gd"
Loader="*res://src/autoload/scene_loader.gd"
SoftKeyboard="*res://src/autoload/soft_keyboard.gd"
PixelGrid="*res://src/autoload/pixel_grid.gd"
MenuNav="*res://src/autoload/menu_nav.gd"
OnlineSession="*res://src/autoload/online_session.gd"
Leaderboards="*res://src/autoload/leaderboards.gd"
Privacy="*res://src/autoload/privacy.gd"
Telemetry="*res://src/autoload/telemetry.gd"
WorldStats="*res://src/autoload/world_stats.gd"
RemoteConfig="*res://src/autoload/remote_config.gd"
Feedback="*res://src/autoload/feedback.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom="res://assets/theme/main_theme.tres"

