id = &"forge"
cue = &"forge_near"
title = "The forge"
text = "Tap Forge at the anvil to set your runes."
button_text = "Press {interact} at the anvil to set your runes."
target = &"InteractButton"
done_when = &"interacted"
duration = 10.0

