[gd_resource type="Resource" script_class="TutorialDef" format=3]

[ext_resource type="Script" path="res://src/definitions/tutorial_def.gd" id="1_tutorial"]
[ext_resource type="Script" path="res://src/definitions/hint_def.gd" id="2_hint"]

[sub_resource type="Resource" id="Hint_move"]
script = ExtResource("2_hint")
id = &"move"
cue = &"run_start"
title = "Move"
text = "Drag your thumb on the left side to walk."
button_text = "Walk with {move}."
target = &"Joystick"
done_when = &"moved"
duration = 20.0
priority = 10

[sub_resource type="Resource" id="Hint_seal"]
script = ExtResource("2_hint")
id = &"seal"
after = &"move"
only_if = &"sealed"
title = "Sealed stairs"
text = "Slay monsters: the count is under the map."
target = &"SealLabel"
duration = 9.0

[sub_resource type="Resource" id="Hint_attack"]
script = ExtResource("2_hint")
id = &"attack"
cue = &"monster_noticed"
after = &"move"
title = "Attack"
text = "Tap the big button to strike the closest enemy."
button_text = "Press {attack} to strike the closest enemy."
target = &"AttackButton"
done_when = &"attacked"
duration = 20.0
priority = 9

[sub_resource type="Resource" id="Hint_roll"]
script = ExtResource("2_hint")
id = &"roll"
after = &"attack"
title = "Roll"
text = "Tap Roll to dash; nothing hurts you mid-roll."
button_text = "Press {skill_1} to roll; nothing hurts you mid-roll."
target = &"Skill1Button"
done_when = &"rolled"
duration = 15.0
priority = 9

[sub_resource type="Resource" id="Hint_weapon_skills"]
script = ExtResource("2_hint")
id = &"weapon_skills"
after = &"roll"
only_if = &"has_weapon_skill"
title = "Weapon skills"
text = "Your weapon has two skills of its own. Try them!"
button_text = "{skill_2} and {skill_3}: your weapon's own skills."
target = &"Skill2Button"
done_when = &"weapon_skill"
duration = 15.0
priority = 9

[sub_resource type="Resource" id="Hint_charge"]
script = ExtResource("2_hint")
id = &"charge"
after = &"weapon_skills"
title = "Charged attack"
text = "Hold the big button; let go when the ring fills."
button_text = "Hold {attack}; let go when the ring fills."
target = &"AttackButton"
done_when = &"charged"
duration = 14.0
priority = 9

[sub_resource type="Resource" id="Hint_potion"]
script = ExtResource("2_hint")
id = &"potion"
cue = &"low_health"
only_if = &"has_belt_item"
title = "Low health"
text = "Tap the potion on your belt to drink it."
button_text = "Press {quick_item} to drink your belt's potion."
target = &"QuickItemButton"
done_when = &"used_item"
duration = 12.0
priority = 8

[sub_resource type="Resource" id="Hint_souls"]
script = ExtResource("2_hint")
id = &"souls"
cue = &"monster_killed"
after = &"attack"
title = "Souls"
text = "Monsters free souls: spend them at the shrine."
target = &"SoulsLabel"
duration = 9.0

[sub_resource type="Resource" id="Hint_perks"]
script = ExtResource("2_hint")
id = &"perks"
cue = &"offer_waiting"
title = "Perks"
text = "Each level brings a perk: tap the glowing button."
button_text = "Each level brings a perk: press {offers}."
target = &"OffersButton"
done_when = &"opened_offers"
duration = 14.0

[sub_resource type="Resource" id="Hint_synergy"]
script = ExtResource("2_hint")
id = &"synergy"
cue = &"synergy"
title = "Family bonus"
text = "Three of a family: its bonus is yours this run."
duration = 8.0

[sub_resource type="Resource" id="Hint_gear"]
script = ExtResource("2_hint")
id = &"gear"
cue = &"gear_carried"
title = "New gear"
text = "Open the Bag to compare it and equip it."
button_text = "Open the Bag ({inventory}) to compare and equip it."
target = &"BagButton"
done_when = &"opened_bag"
duration = 12.0

[sub_resource type="Resource" id="Hint_spell"]
script = ExtResource("2_hint")
id = &"spell"
cue = &"spell_learned"
title = "Spell"
text = "It has its own button; a new tome replaces it."
button_text = "{skill_4} casts it; a new tome replaces it."
target = &"Skill4Button"
duration = 10.0

[sub_resource type="Resource" id="Hint_elite"]
script = ExtResource("2_hint")
id = &"elite"
cue = &"elite_noticed"
title = "Elite"
text = "Tougher, but it drops better loot, even runes."
duration = 9.0

[sub_resource type="Resource" id="Hint_rune"]
script = ExtResource("2_hint")
id = &"rune"
cue = &"rune_carried"
title = "Rune"
text = "Set runes into your weapon at a smith's forge."
duration = 10.0

[sub_resource type="Resource" id="Hint_forge"]
