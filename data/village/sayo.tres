[resource]
script = ExtResource("script")
id = &"sayo"
speaker = ExtResource("speaker")
position = Vector2(190, 210)
role = 1
quest = ExtResource("quest")
wakes_after = ExtResource("quest")
echo = true
text = "Can you really hear me? I am trying to finish a song, but the same line keeps slipping away."
accepted_text = "The last verse is on a sheet that fell to the fourth floor. Bring it to me; I would like to try reading it aloud."
found_text = "That sheet... it is my handwriting. Give it to me, I think I remember."
used_text = "I had forgotten what it felt like to be cold. Thank you for coming back for me."
ambient_before = PackedStringArray("Is someone there?", "How did that song end...")
ambient_after = PackedStringArray("Ren, a little less smoke, please.", "You can stop for a moment, you know.")
topics = [ExtResource("topic_0"), ExtResource("topic_1"), ExtResource("topic_2")]
idle_frames = [Rect2(0, 0, 16, 16), Rect2(0, 16, 16, 16)]
appearance = ExtResource("appearance")
schedule = [SubResource("activity_0"), SubResource("activity_1"), SubResource("activity_2"), SubResource("activity_3"), SubResource("activity_4"), SubResource("activity_5")]
walk_speed = 42.0
