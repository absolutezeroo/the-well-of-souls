[gd_resource type="Resource" script_class="VillageTopicDef" format=3]
[ext_resource type="Script" path="res://src/definitions/village/village_topic_def.gd" id="script"]
[resource]
script = ExtResource("script")
prompt = "Why pay for lanterns?"
reply = "The souls go into the lights, not my pocket. I provide the oil, the wicks and the knees that climb the ladder."
