[resource]
script = ExtResource("script")
prompt = "Who are the white flowers for?"
reply = "For those who go down and do not come up. I grew them for every grave Sayo sang over; the Ossuary has more of my flowers than my garden."
quest = ExtResource("gate")
min_stage = 0
max_stage = 2
