[gd_resource type="Resource" script_class="VillageTopicDef" format=3]
[ext_resource type="Script" path="res://src/definitions/village/village_topic_def.gd" id="script"]
[resource]
script = ExtResource("script")
prompt = "Why his ember-box?"
reply = "He kept it close so the embers would last until morning. I want to give him back something he will recognise."
