[resource]
script = ExtResource("script")
prompt = "Who sleeps on the southern lane?"
reply = "Gen, who grew the white flowers for every song I sang at a grave. Without them my verses had nothing to fall on."
quest = ExtResource("gate")
min_stage = 0
max_stage = 2
after_quest = ExtResource("after")
