[resource]
script = ExtResource("script")
id = &"wanderer"
speaker = ExtResource("speaker")
position = Vector2(300, 720)
role = 2
quest = ExtResource("quest")
echo = false
text = "Four streets, one well, and not a customer on their feet. Bring back one neighbour first; then we can talk about those lanterns."
used_text = "Ren has already told me my wicks are too short. It is good to have difficult people back."
ambient_before = PackedStringArray("I keep the stall open. Out of habit.")
ambient_after = PackedStringArray("Oil, wicks... I even give ghosts credit.", "Mind your step, I have just tidied up.")
topics = [ExtResource("topic_0"), ExtResource("topic_1")]
idle_frames = [Rect2(0, 0, 16, 16), Rect2(0, 16, 16, 16)]
walk_frames = [Rect2(0, 32, 16, 16), Rect2(0, 48, 16, 16), Rect2(0, 64, 16, 16), Rect2(0, 80, 16, 16)]
reactions = [ExtResource("reaction_three"), ExtResource("reaction")]
schedule = [SubResource("activity_0"), SubResource("activity_1"), SubResource("activity_2"), SubResource("activity_3"), SubResource("activity_4")]
walk_speed = 42.0
