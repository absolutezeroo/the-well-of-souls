[resource]
script = ExtResource("script")
id = &"keeper"
speaker = ExtResource("speaker")
position = Vector2(540, 280)
role = 1
quest = ExtResource("quest")
echo = false
text = "There you are, child. Ren will not wake; I would like to try giving him back the ember-box he carried everywhere."
accepted_text = "It fell to the second floor. If things go badly, come back; I would rather see you empty-handed."
found_text = "You found it, child. Give it to me; let us try to bring Ren back."
used_text = "Listen to him grumbling about his wicks: Ren is back indeed. Go and see Sayo by the western house; she may need you."
ambient_before = PackedStringArray("Come closer, child. I need your help.", "Take a moment to catch your breath.")
ambient_after = PackedStringArray("Ren is up already... That man cannot sit still.", "Is your lantern holding up?")
topics = [ExtResource("topic_0"), ExtResource("topic_1")]
idle_frames = [Rect2(0, 0, 16, 16), Rect2(0, 16, 16, 16)]
reactions = [ExtResource("reaction")]
schedule = [SubResource("activity_0"), SubResource("activity_1"), SubResource("activity_2"), SubResource("activity_3"), SubResource("activity_4")]
walk_speed = 42.0
