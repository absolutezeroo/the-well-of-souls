[resource]
script = ExtResource("script")
id = &"gen"
speaker = ExtResource("speaker")
position = Vector2(454, 838)
role = 1
quest = ExtResource("quest")
wakes_after = ExtResource("quest")
echo = true
text = "The frost is coming, and I have not sown the white rows. Where did I put my seeds?"
accepted_text = "I carried them down to the Ossuary for the niches, and the earth sank with them. The fifth floor, I think; it smells of wet stone."
found_text = "I would know that pouch's knot with my eyes shut. Give it here."
used_text = "The rows are late, but the earth forgives. Sayo will have her flowers for the next song."
ambient_before = PackedStringArray("Before the frost... before the frost...", "Who walks on my rows?")
ambient_after = PackedStringArray("Mind the seedlings.", "White for the dead, green for the living.")
topics = [ExtResource("topic_0"), ExtResource("topic_1"), ExtResource("topic_2")]
idle_frames = [Rect2(0, 0, 16, 16), Rect2(0, 16, 16, 16)]
walk_frames = [Rect2(0, 32, 16, 16), Rect2(0, 48, 16, 16), Rect2(0, 64, 16, 16), Rect2(0, 80, 16, 16)]
schedule = [SubResource("activity_0"), SubResource("activity_1"), SubResource("activity_2"), SubResource("activity_3"), SubResource("activity_4"), SubResource("activity_5")]
walk_speed = 30.0
