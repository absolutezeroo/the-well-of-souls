[gd_resource type="Resource" script_class="PerkDef" format=3]

[ext_resource type="Texture2D" path="res://assets/items/tome_fire.png" id="1_icon"]
[ext_resource type="Script" path="res://src/definitions/passives/passive.gd" id="2_passive"]
[ext_resource type="Script" path="res://src/definitions/passives/pyre_kill_passive.gd" id="3_pyre"]
[ext_resource type="Script" path="res://src/definitions/effects/on_hit_status.gd" id="4_status"]
[ext_resource type="Script" path="res://src/definitions/perk_def.gd" id="5_perk"]
[ext_resource type="Script" path="res://src/definitions/synergy_def.gd" id="6_synergy"]
[ext_resource type="Resource" path="res://data/perks/synergies/inferno.tres" id="7_inferno"]
[ext_resource type="Resource" path="res://data/vfx/elements/fire.tres" id="vfx_fire"]

[sub_resource type="Resource" id="Resource_burn"]
script = ExtResource("4_status")
burn_damage = 3

[sub_resource type="Resource" id="Resource_pyre"]
script = ExtResource("3_pyre")
blast_radius = 72.0
blast_damage = 1.2
blast_status = SubResource("Resource_burn")
blast_knockback = 40.0
blast_element = ExtResource("vfx_fire")

[resource]
script = ExtResource("5_perk")
role = 2
twist = true
id = &"funeral_pyre"
display_name = "Funeral Pyre"
description = "Every foe you slay explodes in flames that burn those around, but the blast burns you too if you stand in it (6% of your max Health)."
icon = ExtResource("1_icon")
color = Color(1, 0.54901963, 0.25882354, 1)
rarity = 1
max_stacks = 1
synergies = Array[ExtResource("6_synergy")]([ExtResource("7_inferno")])
passives = Array[ExtResource("2_passive")]([SubResource("Resource_pyre")])
