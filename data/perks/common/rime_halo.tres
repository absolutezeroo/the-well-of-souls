[gd_resource type="Resource" script_class="PerkDef" format=3]

[ext_resource type="Texture2D" path="res://assets/ui/skills/riposte.png" id="1_icon"]
[ext_resource type="Script" path="res://src/definitions/passives/passive.gd" id="2_passive"]
[ext_resource type="Script" path="res://src/definitions/passives/frost_orbit_passive.gd" id="3_orbit"]
[ext_resource type="Script" path="res://src/definitions/effects/on_hit_status.gd" id="4_status"]
[ext_resource type="Script" path="res://src/definitions/perk_def.gd" id="5_perk"]
[ext_resource type="Script" path="res://src/definitions/synergy_def.gd" id="6_synergy"]
[ext_resource type="Resource" path="res://data/perks/synergies/frost.tres" id="7_frost"]
[ext_resource type="Resource" path="res://data/vfx/elements/frost.tres" id="vfx_frost"]

[sub_resource type="Resource" id="Resource_chill"]
script = ExtResource("4_status")
slow = 0.3
slow_duration = 1.0

[sub_resource type="Resource" id="Resource_orbit"]
script = ExtResource("3_orbit")
status = SubResource("Resource_chill")
element = ExtResource("vfx_frost")

[resource]
script = ExtResource("5_perk")
role = 2
id = &"rime_halo"
display_name = "Rime Halo"
description = "2 shards of ice circle you (+1 per level), hurting the enemies they pass through and slowing them by 30%."
icon = ExtResource("1_icon")
color = Color(0.5568628, 0.7921569, 0.9019608, 1)
weight = 6
synergies = Array[ExtResource("6_synergy")]([ExtResource("7_frost")])
passives = Array[ExtResource("2_passive")]([SubResource("Resource_orbit")])
