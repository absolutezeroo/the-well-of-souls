[gd_resource type="Resource" script_class="PrivacyDef" format=3]

[ext_resource type="Script" path="res://src/definitions/online/privacy_def.gd" id="1_privacy"]
[ext_resource type="Script" path="res://src/definitions/online/policy_section_def.gd" id="2_section"]

[sub_resource type="Resource" id="who"]
script = ExtResource("2_section")
title = "Who is responsible"
text = "Le Puits des Âmes (The Well of Souls) is made by {controller}, who decides what happens to your data. For anything about it, write to {email}."

[sub_resource type="Resource" id="short"]
script = ExtResource("2_section")
title = "In short"
text = "No account, no email, no ads, no purchases, no location, no advertising ID. The game plays fully offline. Nothing leaves your device unless you turn on one of the two online features below (each one can be turned off at any time in Options > Privacy), or send a message from Send feedback."

[sub_resource type="Resource" id="boards"]
script = ExtResource("2_section")
title = "Online leaderboards (only if you publish your scores)"
text = "When you choose to publish your scores, the game sends: a random ID made on this device, the pseudonym you pick, and your Dawn Knell scores with a summary of the run (version, day, floors, kills, time, weapon, difficulty). The pseudonym, the scores and their summary are public: every player sees them, and the technical ID can be read by anyone querying the leaderboard. Why: to show the leaderboards you asked for (the service you request). Kept until you ask for deletion, or {purge_months} months after you last played."

[sub_resource type="Resource" id="stats"]
script = ExtResource("2_section")
title = "Gameplay statistics (only if you accept)"
text = "If you accept, at the end of each run, or when it is left or the app is closed, the game sends a summary of it: your build (weapons, armor, skills and their damage), potions, dodges, the cause and floor of your death, perks offered and picked, in-game purchases, boss fights, the kind of controls you use, plus the game version, the system and the screen size. It is linked to the random ID of this device, never to your name. Your runs also add to the world counters every player sees (the Well's Toll: monsters slain, wardens defeated, deaths, floors, potions, endings, Dawn Knells, souls offered), sent at the same moments: your own totals are kept with the same random ID, and only the sums of all players are shown. While the game is open, it also keeps a connection to Talo, so Talo records when each play session starts and ends and shows you as online; it closes when the app goes to the background. Why: to balance the game, fix its bugs, show the world counters and count play sessions and players online. Basis: your consent, which you can withdraw at any time in Options > Privacy; refusing changes nothing in the game. Kept {months} months. Only offered to players aged {age} or older."

[sub_resource type="Resource" id="settings"]
script = ExtResource("2_section")
title = "Game settings from the server"
text = "Once one of the online features is on, the game also asks Talo now and then for its current settings (balance fixes, events, a message on the title screen). No ID is sent with that request; like any connection, it shows Talo your device's IP address. Why: to keep the game fair and working without an update (legitimate interest). The settings read are kept on your device."

[sub_resource type="Resource" id="feedback"]
script = ExtResource("2_section")
title = "Feedback (only when you send a message)"
text = "When you send a message from Send feedback (in the pause menu, or Feedback on the title screen), the game sends your words and their kind (bug, idea, other). Only if you leave them ticked: the game's details (the game's version and build type, the system and its version, the device model, the screen and window size, the controls in use and the gamepad's family, the language; during a run, its floor, act, place, biome, difficulty, ascension, whether it is a Dawn Knell, oath, time and level, and your build: weapon, armor, awakened families, relics, perks and skills; on a computer, the last lines of the game's log, with your folders hidden) and your pseudonym. It is linked to the random ID of this device. Why: to read your message and fix what it reports. Basis: your own request, message by message: nothing is sent before you press Send. Kept until you ask for deletion, or {purge_months} months after you last played online."

[sub_resource type="Resource" id="device"]
script = ExtResource("2_section")
title = "On your device"
text = "Your progress, your settings, your choices about privacy and the random ID are kept on this device only. They never leave it, except as said above. Uninstalling the game deletes them."

[sub_resource type="Resource" id="who_receives"]
script = ExtResource("2_section")
title = "Who receives it"
text = "Talo (Talo Platform Ltd, United Kingdom), the online service the game uses, processes the data on our behalf only, on servers in Germany. Its own subcontractors include Cloudflare (storage, Western Europe) and Sentry (error reports, United States). Nothing is sold, nothing is used for advertising."

[sub_resource type="Resource" id="rights"]
script = ExtResource("2_section")
title = "Your rights"
text = "You can ask to see, correct or delete your data, to limit or object to its use, to receive a copy, and to withdraw your consent; in France you can also leave instructions for after your death. The quickest way: Options > Privacy > Delete my online data, which prepares the email with your online ID. Or write to {email} with that ID (shown in Options > Privacy). You get an answer within one month. You can also complain to the CNIL (cnil.fr) or your own data protection authority."

[sub_resource type="Resource" id="children"]
script = ExtResource("2_section")
title = "Children"
text = "The game is not made for children under 13. Gameplay statistics are never offered to players under {age}. A parent can ask for a child's data to be deleted by writing to {email}."

[sub_resource type="Resource" id="changes"]
script = ExtResource("2_section")
title = "Changes"
text = "Version {version} of {date}. If what the game collects changes, this policy says so first, and for what needs your consent the game asks you again before sending anything new. The full policy: {url}"

[resource]
script = ExtResource("1_privacy")
controller_name = "[CONTROLLER_NAME]"
contact_email = "[CONTACT_EMAIL]"
policy_url = "[POLICY_URL]"
policy_version = "1.5"
policy_date = "2026-10-25"
consent_version = 3
sections = Array[ExtResource("2_section")]([SubResource("who"), SubResource("short"), SubResource("boards"), SubResource("stats"), SubResource("settings"), SubResource("feedback"), SubResource("device"), SubResource("who_receives"), SubResource("rights"), SubResource("children"), SubResource("changes")])
