face_colors = PackedColorArray(0.45, 0.8, 0.3, 1, 0.92, 0.32, 0.27, 1, 0.33, 0.56, 0.95, 1, 0.96, 0.8, 0.26, 1)

[resource]
script = ExtResource("1_prompts")
actions = Array[ExtResource("2_action")]([SubResource("Action_move"), SubResource("Action_attack"), SubResource("Action_skill_1"), SubResource("Action_skill_2"), SubResource("Action_skill_3"), SubResource("Action_skill_4"), SubResource("Action_quick_item"), SubResource("Action_belt_2"), SubResource("Action_belt_3"), SubResource("Action_interact"), SubResource("Action_offers"), SubResource("Action_inventory"), SubResource("Action_map"), SubResource("Action_pause"), SubResource("Action_ui_accept"), SubResource("Action_ui_cancel"), SubResource("Action_menu_tabs"), SubResource("Action_item_dismantle"), SubResource("Action_item_drop"), SubResource("Action_menu_scroll"), SubResource("Action_toggle_fullscreen")])
reserved_actions = Array[StringName]([&"move_up", &"move_left", &"move_down", &"move_right", &"pause", &"toggle_fullscreen"])
pads = Array[ExtResource("3_pad")]([SubResource("Pad_xbox"), SubResource("Pad_playstation"), SubResource("Pad_nintendo"), SubResource("Pad_generic")])
key_codes = PackedInt32Array(4194305, 32, 4194306, 4194309, 4194308, 4194319, 4194320, 4194321, 4194322, 4194325, 4194326, 4194328, 4194342, 44, 46, 59, 47, 39, 91, 93, 45, 61, 92, 96)
key_words = PackedStringArray("Esc", "Space", "Tab", "Enter", "Backspace", "←", "↑", "→", "↓", "Shift", "Ctrl", "Alt", "F11", ",", ".", ";", "/", "'", "[", "]", "-", "=", "\\", "`")
mouse_glyphs = PackedStringArray("", "Left click", "Right click", "Middle click")
stick_deadzone = 0.5
mouse_threshold = 6.0
