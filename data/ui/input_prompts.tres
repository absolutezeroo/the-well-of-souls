[gd_resource type="Resource" script_class="InputPromptsDef" format=3]

[ext_resource type="Script" path="res://src/definitions/input/input_prompts_def.gd" id="1_prompts"]
[ext_resource type="Script" path="res://src/definitions/input/action_prompt_def.gd" id="2_action"]
[ext_resource type="Script" path="res://src/definitions/input/pad_glyphs_def.gd" id="3_pad"]

[sub_resource type="Resource" id="Action_move"]
script = ExtResource("2_action")
action = &"move"
display_name = "Move"
parts = Array[StringName]([&"move_up", &"move_left", &"move_down", &"move_right"])
touch_text = "Drag on the left side of the screen"
joined = true

[sub_resource type="Resource" id="Action_attack"]
script = ExtResource("2_action")
action = &"attack"
remappable = true
display_name = "Attack (hold to charge)"
key = 32
mouse = 1
touch_text = "The big button, bottom right"

[sub_resource type="Resource" id="Action_skill_1"]
script = ExtResource("2_action")
action = &"skill_1"
remappable = true
display_name = "Roll"
key = 49
mouse = 2
touch_text = "The round button left of the attack"

[sub_resource type="Resource" id="Action_skill_2"]
script = ExtResource("2_action")
action = &"skill_2"
remappable = true
display_name = "Weapon skill"
key = 50
touch_text = "The round button above the roll"

[sub_resource type="Resource" id="Action_skill_3"]
script = ExtResource("2_action")
action = &"skill_3"
remappable = true
display_name = "Second weapon skill"
key = 51
touch_text = "The round button above the attack"

[sub_resource type="Resource" id="Action_skill_4"]
script = ExtResource("2_action")
action = &"skill_4"
remappable = true
display_name = "Spell (from a tome)"
key = 52
touch_text = "The fourth round button, once you know a spell"

[sub_resource type="Resource" id="Action_quick_item"]
script = ExtResource("2_action")
action = &"quick_item"
remappable = true
display_name = "Belt, first slot"
key = 81
touch_text = "The small buttons left of the skills"

[sub_resource type="Resource" id="Action_belt_2"]
script = ExtResource("2_action")
action = &"belt_2"
remappable = true
display_name = "Belt, second slot"
key = 53

[sub_resource type="Resource" id="Action_belt_3"]
script = ExtResource("2_action")
action = &"belt_3"
remappable = true
display_name = "Belt, third slot"
key = 54

[sub_resource type="Resource" id="Action_interact"]
script = ExtResource("2_action")
action = &"interact"
remappable = true
display_name = "Use (trade, forge, read...)"
key = 69
touch_text = "The button over the skills, when something is in reach"

[sub_resource type="Resource" id="Action_offers"]
script = ExtResource("2_action")
action = &"offers"
remappable = true
display_name = "Choose a waiting perk"
key = 67
touch_text = "The golden star, left of the map"

[sub_resource type="Resource" id="Action_inventory"]
script = ExtResource("2_action")
action = &"inventory"
remappable = true
display_name = "Bag"
key = 73
touch_text = "The Bag button"

[sub_resource type="Resource" id="Action_map"]
script = ExtResource("2_action")
action = &"map"
remappable = true
display_name = "Whole floor's map"
key = 77
touch_text = "Tap the minimap"

[sub_resource type="Resource" id="Action_pause"]
script = ExtResource("2_action")
action = &"pause"
display_name = "Pause"
key = 4194305
touch_text = "The II button, or the phone's back button"

[sub_resource type="Resource" id="Action_ui_accept"]
script = ExtResource("2_action")
action = &"ui_accept"
display_name = "Confirm in a menu"
key = 4194309
touch_text = "Tap it"

[sub_resource type="Resource" id="Action_ui_cancel"]
script = ExtResource("2_action")
action = &"ui_cancel"
display_name = "Back in a menu"
key = 4194305
touch_text = "Close, or the phone's back button"

[sub_resource type="Resource" id="Action_menu_tabs"]
script = ExtResource("2_action")
action = &"menu_tabs"
display_name = "Previous / next tab"
parts = Array[StringName]([&"menu_prev_tab", &"menu_next_tab"])
touch_text = "Tap a tab"

[sub_resource type="Resource" id="Action_item_dismantle"]
script = ExtResource("2_action")
action = &"item_dismantle"
display_name = "Dismantle (in the bag)"
key = 88
touch_text = "The Dismantle button on the item's card"

[sub_resource type="Resource" id="Action_item_drop"]
script = ExtResource("2_action")
action = &"item_drop"
display_name = "Drop (in the bag)"
key = 71
touch_text = "The Drop button on the item's card"

[sub_resource type="Resource" id="Action_menu_scroll"]
script = ExtResource("2_action")
action = &"menu_scroll"
display_name = "Scroll an item's card"
parts = Array[StringName]([&"menu_scroll_up", &"menu_scroll_down"])
touch_text = "Drag the details"

[sub_resource type="Resource" id="Action_toggle_fullscreen"]
script = ExtResource("2_action")
action = &"toggle_fullscreen"
display_name = "Fullscreen"
key = 4194342

[sub_resource type="Resource" id="Pad_xbox"]
script = ExtResource("3_pad")
id = &"xbox"
brand = "Xbox"
