[gd_resource type="Resource" script_class="BalanceTargets" format=3]

[ext_resource type="Script" path="res://tools/balance/balance_targets.gd" id="1_d0mpv"]

; The design goals of the game's balance, read by tools/balance (model, arena, lab) and the
; "balance" test suite. FIRST PROPOSAL (2026-10-20): sensible action-roguelike values for a phone
; game, to be tuned with the owner. Each line says why; the same reasons are on BalanceTargets'
; fields and in docs/balance.md > Tools > Targets (the editor drops these comments if it saves
; this file: keep them in sync by hand).

[resource]
script = ExtResource("1_d0mpv")
; A boss fight with the act's expected build should last 40-100 s: under that it is not a fight, over it it drags on a phone.
boss_ttk_min = 40.0
boss_ttk_max = 100.0
; A rare-rank boss (Epic, Legendary, Shiny) is an event: it may last longer, not forever.
ranked_boss_ttk_max = 150.0
; Standing still and trading blows must never beat a boss: expected and degenerate builds must die face-tanking...
facetank_must_lose_tags = PackedStringArray("expected", "degenerate")
; ...from Normal up (Easy may forgive it).
facetank_must_lose_from = &"normal"
; A face-tank win that spent a second life (it died, played the Threshold and came back) is a loss: the boss killed the hero who did not dodge; a once-a-run safety net is not a way to beat a boss by standing still, and bosses must not be tuned to kill twice. Its heal is left out of the heal shares below (2026-10-23).
facetank_second_life_is_loss = true
; Healing in a boss fight tops you up, it doesn't undo the boss: at most 25% of the damage taken for an expected build...
heal_share_max_expected = 0.25
; ...and at most 50% for a build that stacks sustain on purpose (degenerate, family builds).
heal_share_max_degenerate = 0.5
; Both only for a fight where the hero took at least 30% of his max Health: healing 80 of 120 taken in a fight he nearly didn't feel is no sustain problem (2026-10-27, task_211).
heal_share_min_taken = 0.3
; At full health, 6 average boss hits at least (one mistake isn't the end)...
boss_hits_to_kill_min = 6.0
; ...and 12 at most (ignoring the patterns must kill you; a hit-free fight stays possible).
boss_hits_to_kill_max = 12.0
; Keeping range and rolling away from telegraphs should beat the act's boss with the expected build on Easy and Normal.
kite_should_win_on = PackedStringArray("easy", "normal")
; Readable dives (every boss, unit tests): a dive or leap warns at least 0.45 s in the boss' last phase on Keeper (a person sees the line and steps off it; the Azure Wyrm's at 0.30 s and the Jade Wyrm's were not), and hits a band at most 8 px wider than the boss' body each side of its line (2026-10-23).
dive_warning_min = 0.45
dive_band_margin = 8.0
; The average player (gauntlet's player bot: kite with a 0.3 s reaction) plays every act through (last floor, then the boss, Health carried) on Pilgrim: it stays accessible.
gauntlet_player_wins_on = PackedStringArray("easy")
; Keeper: the average player spends 20-60% of his resources (Health and what his potions heal) on an act's last floor before the boss, mean over the acts: the rooms are a fight, not a stroll that hands out potions; he still reaches the boss with a chance.
gauntlet_keeper_floor_cost_min = 0.2
gauntlet_keeper_floor_cost_max = 0.6
; Keeper: the average player wins at least 3 acts in 4 (boss included): a challenge, not a wall.
gauntlet_keeper_player_wins_min = 0.75
; Keeper's curve: act I's floors cost at most 25% of max Health (model: a room face to face; gauntlet: a floor of rooms for the kite bot), where a player learns.
curve_bot = &"kite"
curve_first_act_cost_max = 0.25
; Each act a little harder than the last (threat x0.9-x1.6 act over act): a steady curve, no wall.
act_threat_step_min = 0.9
act_threat_step_max = 1.6
; The monsters' curves (commons, rooms): act II may be up to x2.5 act I, which is gentle on purpose (where a player learns, the hero levelling from 1 to 6); later steps x0.9-x1.6.
first_act_step_max = 2.5
; The commons' curve: each act's commons cost at least x1.05 the last's (no flat stretch: "you roll until floor 8", the owner).
monster_step_min = 1.05
; Each difficulty's boss threat vs Normal: Easy forgiving, Nightmare demanding, ascensions add on top without walls.
difficulty_threat = {
"easy": Vector2(0.2, 0.7),
"hard": Vector2(1.3, 2.6),
"nightmare": Vector2(2, 5),
"nightmare+10": Vector2(3, 12),
"nightmare+5": Vector2(2.5, 8)
}
; A common monster takes 0.5-2.5 s of hitting: paper below, a slog above (rooms hold 2-6 of them).
common_ttk_min = 0.5
common_ttk_max = 2.5
; Ranked monsters: an Elite is a short duel (3-10 s), an Epic a longer one, a Legendary a mini-boss, a Shiny a treasure that shouldn't take long.
rank_ttk = {
"elite": Vector2(3, 10),
"epic": Vector2(5, 16),
"legendary": Vector2(8, 25),
"shiny": Vector2(2, 10)
}
; Each rank takes at least 1.2x as long to kill as the rank below it (medians per act, Normal) and costs more health: a clearly tougher fight, not a recolor.
rank_ladder_step_min = 1.2
; One common monster must never be a two-shot: 6 average hits at least to kill the act's expected build.
common_hits_to_kill_min = 6.0
; Clearing a room while playing well (kite bot) costs at most 35% of max health...
pack_damage_share_max = 0.35
; ...and takes at most 25 s.
pack_clear_max = 25.0
; No single pick at max level is worth more than 2x the median of its category (perks, relics, families, runes, affixes, shrine levels, encounters)...
perk_value_max_vs_median = 2.0
; ...nor less than half of it (a trap).
perk_value_min_vs_median = 0.5
; The static perk table (model) is measured on the act II expected build; the lab measures every act.
perk_reference_build = "expected_a2"
; Stacking one thing hard may pay up to 2.5x the expected build's damage, not more.
degenerate_dps_ratio_max = 2.5
; Every weapon within 0.75x-1.4x of the median weapon's DPS (same rarity, same hero, every act): none is a trap, none the only choice (phase 2C: was 0.6-1.6, a 2.7x spread between weapons; every weapon now fits the tighter band).
weapon_dps_ratio_min = 0.75
weapon_dps_ratio_max = 1.4
; A weapon (Common, expected build, kite) should beat at least half the bosses on Normal.
weapon_boss_win_share_min = 0.5
; Any combination of multiplying bonuses (attack speed x crit x damage, projectiles, echo, burns) at most 2.5x the expected build's DPS.
compound_dps_ratio_max = 2.5
; Armor may make weak monsters weaker, not harmless: at most half the act's monsters hit the most armored build for 1.
min_damage_share_max = 0.5
; One sustain source alone (a Leech rune, Vampirism, Fury) should almost never hit the shared budget against packs (<= 10% cut).
single_source_cut_max = 0.1
; Gold between two merchants should buy 0.8-3 items of their stock: something most visits, never everything.
gold_per_visit_items_min = 0.8
gold_per_visit_items_max = 3.0
; A merchant reroll costs at most 35% of a floor's gold; removing a rune at the forge at most 60%.
reroll_floor_share_max = 0.35
forge_floor_share_max = 0.6
; A Keeper career with every source (runs, bestiary ranks and challenges, achievements, quests) fills the Tree of Souls in 40-60 runs (about 20-35 hours): a campaign, not a few evenings.
campaign_runs_to_tree_min = 40.0
campaign_runs_to_tree_max = 60.0
; The first node is bought after run 2 at the latest.
campaign_first_node_runs_max = 2
; Hunter ranks, challenges and achievements pay at most 20% of the full tree in the first 10 runs.
campaign_burst_share_max = 0.2
; A Pilgrim career (Pilgrim's souls, no achievements: feats don't count there) fills the tree in 1.25-2x the runs of a Keeper career: it progresses, more slowly than Keeper, never faster for less risk (2026-10-23).
pilgrim_tree_runs_ratio_min = 1.25
pilgrim_tree_runs_ratio_max = 2.0
; The first node is bought after Pilgrim run 3 at the latest.
pilgrim_first_node_runs_max = 3
