[resource]
script = ExtResource("1_fragmentdef")
id = &"jade_wyrm_ordinance"
title = "The Priests' Ordinance"
author = "The high priest of Solhar"
place = "The Hushed Archive, shelf of rites"
lines = PackedStringArray("The Gentle One rises only for the willing, those who take the rite at its hardest.", "The lukewarm she swallows without a glance.", "Let only those who come down as martyrs approach her head.")
